output "instance_id" {
  description = "UUID of the created OpenStack instance"
  value       = openstack_compute_instance_v2.instance.id
}

output "instance_name" {
  description = "Name of the created OpenStack instance"
  value       = openstack_compute_instance_v2.instance.name
}

output "boot_volume_id" {
  description = "UUID of the newly created Cinder boot volume"
  value       = openstack_blockstorage_volume_v3.boot_volume.id
}

output "private_ip" {
  description = "Internal IPv4 address of the instance port"
  value       = openstack_networking_port_v2.port.all_fixed_ips[0]
}


output "security_group_id" {
  description = "UUID of the created security group"
  value       = openstack_networking_secgroup_v2.secgroup.id
}

output "keypair_name" {
  description = "Keypair name used for SSH access"
  value       = openstack_compute_keypair_v2.keypair.name
}

output "keypair_private_key" {
  description = "Generated private key if auto-generated by OpenStack Nova"
  value       = openstack_compute_keypair_v2.keypair.private_key
  sensitive   = true
}

output "network_id" {
  description = "UUID of the created private network"
  value       = openstack_networking_network_v2.network.id
}

output "subnet_id" {
  description = "UUID of the created private subnet"
  value       = openstack_networking_subnet_v2.subnet.id
}

output "router_id" {
  description = "UUID of the created router"
  value       = openstack_networking_router_v2.router.id
}
